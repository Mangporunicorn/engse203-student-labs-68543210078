NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ⭐⭐ Challenge Turso — เว้นว่างไว้ = ใช้ campus.db ในเครื่อง
# ค่าจริงใส่ใน .env (ห้าม commit) หรือใน Environment ของ Render
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# JWT สำหรับ production ต้องกำหนดค่าจริงใน Environment
JWT_SECRET=
JWT_EXPIRES_IN=2h
